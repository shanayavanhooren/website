setwd("~/Dropbox/ccpd_provinces_2026/")
library(tidyverse)
library(readxl)
library(stringr)
library(stringi)
library(purrr)
# Normalize district names: remove accents, parentheses, dashes, punctuation
clean_text <- function(x) {
x %>%
stringi::stri_trans_general("Latin-ASCII") %>%
str_remove_all("\\s*\\(.*?\\)") %>%
str_remove_all("\\s*\\[.*?\\]") %>%
str_replace_all("[-\u2013\u2014]", " ") %>%
str_to_lower() %>%
str_trim() %>%
str_replace_all("\\s+", " ") %>%
str_replace_all("[[:punct:]]", "")
}
# Normalize candidate names: remove accents, lowercase, collapse whitespace
normalize_name <- function(x) {
x %>%
stringi::stri_trans_general("Latin-ASCII") %>%
str_to_lower() %>%
str_replace_all("[[:punct:]]+", " ") %>%
str_replace_all("\\s+", " ") %>%
str_trim()
}
