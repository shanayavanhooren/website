library(sf)
library(dplyr)
library(ggplot2)
library(rnaturalearth)
# --- 1. Get Ontario outline ---
ontario <- ne_states(country = "Canada", returnclass = "sf") |>
filter(name == "Ontario")
# --- 2. Define the French River / Lake Nipissing / Mattawa River divide ---
# This line runs roughly:
#   - From the Quebec border (~-79.0, 46.3) westward along the Mattawa River
#   - Through Lake Nipissing (~-79.9, 46.2)
#   - Along the French River to Georgian Bay (~-80.0, 45.9)
#   - Then we extend it west and east to ensure it fully cuts Ontario
divide_line <- st_sfc(
st_linestring(matrix(c(
-95.0,  46.5,   # extend west beyond Ontario boundary
-80.85, 46.05,  # Georgian Bay / French River mouth (northern end)
-80.0,  45.9,   # French River (western stretch)
-79.9,  46.2,   # Lake Nipissing
-79.35, 46.3,   # eastern Lake Nipissing
-79.0,  46.3,   # Mattawa River (near Mattawa town)
-78.7,  46.35,  # Mattawa River continuing east
-74.0,  46.35   # extend east to Quebec border
), ncol = 2, byrow = TRUE)),
crs = 4326
)
# --- 3. Create North and South bounding polygons, split by the divide ---
# North: everything above the line
bbox_north <- st_sfc(st_polygon(list(matrix(
c(-95, 46.0, -95, 57, -74, 57, -74, 46.0,
# trace the divide line in reverse to close the polygon
-78.7, 46.35, -79.0, 46.3, -79.35, 46.3,
-79.9, 46.2, -80.0, 45.9, -80.85, 46.05,
-95, 46.0),
ncol = 2, byrow = TRUE))),
crs = 4326)
bbox_south <- st_sfc(st_polygon(list(matrix(
c(-95, 42, -95, 46.0,
# trace the divide line
-80.85, 46.05, -80.0, 45.9, -79.9, 46.2,
-79.35, 46.3, -79.0, 46.3, -78.7, 46.35,
-74, 46.35, -74, 42, -95, 42),
ncol = 2, byrow = TRUE))),
crs = 4326)
# --- 4. Intersect with Ontario outline ---
regions_sf <- bind_rows(
st_sf(region = "Northern Ontario", geometry = st_intersection(ontario$geometry, bbox_north)),
st_sf(region = "Southern Ontario", geometry = st_intersection(ontario$geometry, bbox_south))
)
# --- 5. Interview counts ---
region_data <- data.frame(
region = c("Northern Ontario", "Southern Ontario"),
n_interviews = c(5, 11)  # North: Red Lake, Greenstone, Deep River, Temiskaming Shores x2
# South: Huron East x2, Mono x2, Brockton x2, Pelee, Arnprior, Prescott x2, Eliz.-Kitley
)
regions_sf <- regions_sf |>
left_join(region_data, by = "region")
# --- 6. Centroids for labels ---
centroids <- regions_sf |>
st_centroid() |>
mutate(
lon = st_coordinates(geometry)[, 1],
lat = st_coordinates(geometry)[, 2]
)
# --- 7. Plot ---
ggplot(regions_sf) +
geom_sf(aes(fill = n_interviews), color = "white", linewidth = 1) +
geom_text(
data = centroids,
aes(x = lon, y = lat, label = paste0(region, "\nn = ", n_interviews)),
size = 3.5, fontface = "bold", color = "white", lineheight = 1.4
) +
scale_fill_distiller(palette = "Blues", direction = 1, name = "Interviews") +
labs(
title    = "Interview Respondents by Region — Ontario",
subtitle = "Divided at the French River / Lake Nipissing / Mattawa River line",
caption  = "North: Red Lake, Greenstone, Deep River, Temiskaming Shores\nSouth: Huron East, Mono, Brockton, Pelee Island, Arnprior, Prescott, Elizabethtown-Kitley"
) +
theme_void(base_family = "serif") +
theme(
plot.title    = element_text(face = "bold", size = 13, hjust = 0.5),
plot.subtitle = element_text(size = 9, hjust = 0.5, color = "grey40"),
plot.caption  = element_text(size = 7, color = "grey50", hjust = 0.5),
legend.position = "bottom"
)
