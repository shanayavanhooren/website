library(sf)
library(dplyr)
library(ggplot2)
# --- 1. Download Ontario's provincial boundary from Natural Earth or use rnaturalearth ---
# install.packages(c("rnaturalearth", "rnaturalearthdata", "sf", "ggplot2", "dplyr"))
library(rnaturalearth)
library(rnaturalearthdata)
# --- 2. Define your interview counts by region ---
region_data <- data.frame(
region = c("North-West", "North-East", "South-West", "South-East"),
n_interviews = c(2, 3, 7, 4)
)
ontario <- ne_states(country = "Canada", returnclass = "sf") |>
filter(name == "Ontario")
# Define the split lines (approximate geographic midpoints for Ontario)
mid_lon <- -84.5
mid_lat <-  49.5
# Create 4 quadrant bounding boxes
bbox_nw <- st_sfc(st_polygon(list(matrix(
c(-95, mid_lat, mid_lon, mid_lat, mid_lon, 57, -95, 57, -95, mid_lat),
ncol = 2, byrow = TRUE))), crs = 4326)
bbox_ne <- st_sfc(st_polygon(list(matrix(
c(mid_lon, mid_lat, -74, mid_lat, -74, 57, mid_lon, 57, mid_lon, mid_lat),
ncol = 2, byrow = TRUE))), crs = 4326)
bbox_sw <- st_sfc(st_polygon(list(matrix(
c(-95, 42, mid_lon, 42, mid_lon, mid_lat, -95, mid_lat, -95, 42),
ncol = 2, byrow = TRUE))), crs = 4326)
bbox_se <- st_sfc(st_polygon(list(matrix(
c(mid_lon, 42, -74, 42, -74, mid_lat, mid_lon, mid_lat, mid_lon, 42),
ncol = 2, byrow = TRUE))), crs = 4326)
# Intersect Ontario outline with each quadrant
regions_sf <- bind_rows(
st_sf(region = "North-West", geometry = st_intersection(ontario$geometry, bbox_nw)),
st_sf(region = "North-East", geometry = st_intersection(ontario$geometry, bbox_ne)),
st_sf(region = "South-West", geometry = st_intersection(ontario$geometry, bbox_sw)),
st_sf(region = "South-East", geometry = st_intersection(ontario$geometry, bbox_se))
)
# --- 4. Join interview counts ---
regions_sf <- regions_sf |>
left_join(region_data, by = "region")
# --- 5. Compute centroids for labels ---
centroids <- regions_sf |>
st_centroid() |>
mutate(
lon = st_coordinates(geometry)[, 1],
lat = st_coordinates(geometry)[, 2]
)
# --- 6. Plot ---
ggplot(regions_sf) +
geom_sf(aes(fill = n_interviews), color = "white", linewidth = 0.8) +
geom_text(
data = centroids,
aes(x = lon, y = lat, label = paste0(region, "\nn = ", n_interviews)),
size = 3.2,
fontface = "bold",
color = "white",
lineheight = 1.3
) +
scale_fill_distiller(
palette  = "Blues",
direction = 1,
name     = "Interviews"
) +
labs(
title    = "Interview Respondents by Region — Ontario",
subtitle = "Regions are approximate. Exact locations not shown.",
caption  = "NW: Red Lake, Greenstone | NE: Deep River, Temiskaming Shores\nSW: Huron East, Mono, Brockton, Pelee Island | SE: Arnprior, Prescott, Elizabethtown-Kitley"
) +
theme_void(base_family = "serif") +
theme(
plot.title    = element_text(face = "bold", size = 13, hjust = 0.5),
plot.subtitle = element_text(size = 9, hjust = 0.5, color = "grey40"),
